; Infernal Swarm Roguelite
; Godot 4.7.1
config_version=5

[application]
config/name="Infernal Swarm"
run/main_scene="res://levels/stronghold.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
EventBus="*res://autoloads/event_bus.gd"
GameManager="*res://autoloads/game_manager.gd"
ProfileManager="*res://autoloads/profile_manager.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.018, 0.055, 1)

[physics]
common/physics_ticks_per_second=60

[input]
move_left={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0)]}
move_right={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0)]}
move_up={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventJoypadMotion,"axis":1,"axis_value":-1.0)]}
move_down={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventJoypadMotion,"axis":1,"axis_value":1.0)]}
pause_game={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]}
confirm={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventKey,"physical_keycode":4194309), Object(InputEventJoypadButton,"button_index":0)]}
cancel={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":1)]}

[layer_names]
2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="Projectiles"
2d_physics/layer_4="Objective"
2d_physics/layer_5="Arena Obstacles"
